---
/**
 * English machine pages (`/en/machines/{slug}/`).
 *
 * Slugs are identical to the French ones, which is what makes the language
 * switcher and the hreflang pairs exact. All markup is shared.
 */
import { publishedMachines } from "@/lib/machines";
import MachinePage from "@/components/MachinePage.astro";

export async function getStaticPaths() {
  const machines = await publishedMachines("en");
  return machines.map((entry) => ({
    params: { slug: entry.id.slice("en/".length) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<MachinePage entry={entry} locale="en" />
