---
import { useTranslations, type Locale } from "@/i18n/ui";
import { ENV } from "@/config/site";

interface Props {
  locale: Locale;
  /** Machine name, so the conversation opens already written. */
  machine?: string;
}
const { locale, machine } = Astro.props;
const t = useTranslations(locale);

const text = machine ? `${t("wa.machine")} ${machine}.` : t("wa.generic");
const number = ENV.whatsapp.replace(/[^\d]/g, "");
const href = number
  ? `https://wa.me/${number}?text=${encodeURIComponent(text)}`
  : null;
---

{
  href && (
    <a class="wa" href={href} target="_blank" rel="noopener noreferrer" aria-label={t("wa.aria")}>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm5.8 14.03c-.24.68-1.4 1.3-1.93 1.35-.53.05-1.03.24-3.47-.72-2.94-1.16-4.8-4.2-4.95-4.4-.14-.19-1.17-1.56-1.17-2.98 0-1.42.75-2.12 1.01-2.41.26-.29.57-.36.76-.36.19 0 .38 0 .55.01.17.01.41-.07.64.48.24.55.79 1.93.86 2.07.07.14.12.31.02.5-.1.19-.15.31-.29.48-.14.17-.3.38-.43.5-.14.15-.29.3-.12.58.17.29.75 1.24 1.62 2.01 1.11.99 2.05 1.3 2.34 1.45.29.14.46.12.63-.07.17-.19.72-.84.91-1.13.19-.29.38-.24.65-.14.26.1 1.65.78 1.93.92.29.14.48.22.55.34.07.12.07.7-.17 1.38z" />
      </svg>
    </a>
  )
}

<style>
  .wa {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 50;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--color-or);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.55);
    transition: transform 0.2s ease, background-color 0.2s ease;
  }
  .wa:hover {
    background: var(--color-or-clair);
    transform: scale(1.04);
  }
  .wa svg {
    width: 1.75rem;
    height: 1.75rem;
    fill: var(--color-noir);
  }
  @media (width >= 48rem) {
    .wa {
      right: 2rem;
      bottom: 2rem;
      width: 3.5rem;
      height: 3.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wa { transition: none; }
    .wa:hover { transform: none; }
  }
</style>
