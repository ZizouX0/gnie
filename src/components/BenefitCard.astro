---
interface Props {
  index: number;
  title: string;
  text: string;
}
const { index, title, text } = Astro.props;
---

<article class="plaque card" data-reveal>
  <span class="num" aria-hidden="true">{String(index).padStart(2, "0")}</span>
  <h3>{title}</h3>
  <p>{text}</p>
</article>

<style>
  .card {
    padding: 1.75rem 1.625rem;
  }
  .num {
    font-family: var(--font-display);
    font-size: 1.375rem;
    color: var(--color-or);
    display: block;
    margin-bottom: 0.5rem;
    line-height: 1;
  }
  h3 {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.625rem;
  }
  p {
    font-size: var(--text-small);
    color: var(--color-gris);
    margin: 0;
  }
</style>
