---
import type { Locale } from "@/i18n/ui";
import { useTranslations } from "@/i18n/ui";

interface Props {
  locale: Locale;
  alternate: { locale: Locale; href: string };
  class?: string;
}
const { locale, alternate, class: className = "" } = Astro.props;
const t = useTranslations(locale);
---

<div class:list={["lang", className]}>
  <span class="on" aria-current="true">{locale.toUpperCase()}</span>
  <span class="sep" aria-hidden="true">/</span>
  <a href={alternate.href} hreflang={alternate.locale} aria-label={t("lang.label")}>
    {alternate.locale.toUpperCase()}
  </a>
</div>

<style>
  .lang {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  .on {
    color: var(--color-or);
  }
  .sep {
    color: var(--color-gris);
  }
  a {
    color: var(--color-gris);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  a:hover {
    color: var(--color-ivoire);
  }
  @media (prefers-reduced-motion: reduce) {
    a { transition: none; }
  }
</style>
