---
/**
 * Home — brands strip (specification §4.3.5).
 *
 * Text only: no manufacturer logo is rehosted while the media-rights question
 * (§2, open question 9) is open, and set in the site's own type the row stays
 * part of the design instead of becoming a wall of foreign artwork.
 *
 * The list is `BRANDS` in src/config/site.ts — pending client confirmation
 * (open question 5). An empty list renders nothing rather than an empty band.
 */
import { BRANDS } from "@/config/site";

interface Props {
  label: string;
}
const { label } = Astro.props;
---

{
  BRANDS.length > 0 && (
    <section class="brands" aria-labelledby="brands-label">
      <div class="wrap row" data-reveal>
        <p id="brands-label" class="eyebrow">
          {label}
        </p>
        <ul class="names">
          {BRANDS.map((brand) => (
            <li>{brand}</li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .brands {
    border-block: 1px solid var(--ligne-faint);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 3rem;
    padding-block: 2rem;
  }
  .names {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .names li {
    font-family: var(--font-display);
    font-size: 1.375rem;
    letter-spacing: 0.16em;
    line-height: 1.2;
    color: var(--color-ivoire);
  }
</style>
