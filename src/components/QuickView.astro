---
/**
 * Catalogue quick-view (decision D13).
 *
 * A secondary control on every catalogue card that opens a slide-over panel —
 * hero shot, excerpt, the first spec rows and a link to the full page — so a
 * visitor can size a machine up without leaving the filtered grid.
 *
 * Built on a native <dialog> opened with showModal(), which gives us the whole
 * accessibility contract for free and correct: focus moves inside, the rest of
 * the page becomes inert, Escape closes, and focus returns to the trigger. The
 * only things the page script adds are the open call, backdrop-click and the
 * scroll lock.
 *
 * With JavaScript off the trigger is hidden (`html.no-js`) and a closed
 * <dialog> renders nothing — the catalogue simply stays a grid of links.
 * Values still marked TODO:NEEDS_INPUT never reach this component (D7).
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Button from "@/components/Button.astro";
import { categoryLabel, useTranslations, type Category, type Locale } from "@/i18n/ui";
import { path } from "@/i18n/routes";

interface Props {
  locale: Locale;
  slug: string;
  name: string;
  category: Category;
  excerpt: string;
  image: ImageMetadata;
  /** Already filtered and capped by the catalogue — six rows at most. */
  rows: { label: string; value: string }[];
}
const { locale, slug, name, category, excerpt, image, rows } = Astro.props;
const t = useTranslations(locale);
const id = `qv-${slug}`;
const cat = categoryLabel(locale, category);
---

{/* The visible label stays short; the accessible name says which machine,
    so a screen-reader user does not meet twelve identical buttons. */}
<button
  type="button"
  class="trigger"
  data-qv-open={id}
  aria-haspopup="dialog"
  aria-label={`${t("catalog.quickView")} — ${name}`}
>
  {t("catalog.quickView")}
</button>

<dialog class="panel" id={id} aria-labelledby={`${id}-title`}>
  <div class="inner">
    <button type="button" class="x" data-qv-close aria-label={t("a11y.close")} autofocus>
      <span aria-hidden="true">×</span>
    </button>

    <div class="shot">
      <Image
        src={image}
        alt={`${name} — ${cat}`}
        widths={[320, 480, 720]}
        sizes="(width >= 34rem) 28rem, 90vw"
        loading="lazy"
      />
    </div>

    <p class="eyebrow">{cat}</p>
    <h2 id={`${id}-title`}>{name}</h2>
    <p class="ex">{excerpt}</p>

    {
      rows.length > 0 && (
        <dl class="plaque rows">
          {rows.map((r) => (
            <div class="row">
              <dt>{r.label}</dt>
              <dd>{r.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    {/* Named for its destination: a dozen anchors all reading
        "Découvrir" tell neither a crawler nor a screen reader
        which machine they lead to. */}
    <Button href={path(locale, "machines", slug)} block ariaLabel={`${t("cta.more")} — ${name}`}>
      {t("cta.more")}
    </Button>
  </div>
</dialog>

<style>
  /* ── Trigger: secondary to the card's own "Découvrir →" ─────── */
  .trigger {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem; /* 44px touch target */
    padding: 0.5rem 0;
    border: 0;
    background: none;
    color: var(--color-or);
    font: inherit;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-color: var(--ligne);
    text-underline-offset: 4px;
    cursor: pointer;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }
  .trigger:hover {
    color: var(--color-or-clair);
    text-decoration-color: currentcolor;
  }
  /* No JavaScript, no panel — so no control that leads nowhere. */
  :global(html.no-js) .trigger {
    display: none;
  }

  /* ── Slide-over panel ──────────────────────────────────────── */
  .panel {
    /* pinned to the right edge, full height */
    margin: 0 0 0 auto;
    width: min(30rem, 100%);
    max-width: 100%;
    height: 100dvh;
    max-height: 100dvh;
    padding: 0;
    border: 0;
    border-left: 1px solid var(--ligne);
    background: var(--color-noir);
    color: var(--color-ivoire);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .panel::backdrop {
    background: rgb(4 4 5 / 0.72);
  }
  /* Enter/leave gesture. Unsupported browsers simply get an instant panel. */
  @media (prefers-reduced-motion: no-preference) {
    .panel {
      translate: 100% 0;
      transition: translate 0.28s ease, overlay 0.28s allow-discrete,
        display 0.28s allow-discrete;
    }
    .panel[open] {
      translate: 0 0;
    }
    @starting-style {
      .panel[open] {
        translate: 100% 0;
      }
    }
    .panel::backdrop {
      opacity: 0;
      transition: opacity 0.28s ease, overlay 0.28s allow-discrete,
        display 0.28s allow-discrete;
    }
    .panel[open]::backdrop {
      opacity: 1;
    }
    @starting-style {
      .panel[open]::backdrop {
        opacity: 0;
      }
    }
  }

  .inner {
    padding: 1.25rem 1.25rem 2rem;
  }
  @media (width >= 34rem) {
    .inner {
      padding: 1.5rem 2rem 2.5rem;
    }
  }

  .x {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-left: auto;
    border: 1px solid var(--ligne);
    border-radius: var(--radius-plaque);
    background: transparent;
    color: var(--color-or);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .x:hover {
    border-color: var(--color-or);
    color: var(--color-or-clair);
  }

  .shot {
    margin-top: 0.75rem;
    border: 1px solid var(--ligne-faint);
    border-radius: var(--radius-plaque);
    background: var(--color-graphite);
    padding: 0.5rem;
  }
  .shot :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    filter: saturate(0.88) brightness(0.97);
  }

  .eyebrow {
    margin-top: 1.5rem;
  }
  h2 {
    font-size: 1.75rem;
    margin-top: 0.5rem;
  }
  .ex {
    color: var(--color-gris);
    font-size: var(--text-small);
    margin: 0.875rem 0 0;
  }

  /* Same engraved-plate language as the full spec plate, at panel scale. */
  .rows {
    margin: 1.75rem 0 1.75rem;
    padding: 0.5rem 1.125rem;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.25rem;
    padding: 0.625rem 0;
    border-top: 1px solid var(--ligne-ghost);
    font-size: var(--text-small);
  }
  .row:first-child {
    border-top: 0;
  }
  dt {
    color: var(--color-gris);
  }
  dd {
    margin: 0;
    text-align: right;
    font-weight: 500;
  }
</style>
