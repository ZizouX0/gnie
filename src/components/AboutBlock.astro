---
/**
 * Home — about GNIE (specification §4.3.6).
 *
 * A compact company block: the prose comes from the page files, the facts from
 * CONTACT in src/config/site.ts, so the year and the address can never drift
 * between the two languages — or between this block and the footer.
 */
import SectionHeading from "@/components/SectionHeading.astro";
import Button from "@/components/Button.astro";
import { useTranslations, type Locale } from "@/i18n/ui";
import { path } from "@/i18n/routes";
import { CONTACT } from "@/config/site";

interface Props {
  locale: Locale;
  eyebrow: string;
  title: string;
  paragraphs: string[];
  /** Labels only — the values are company facts, not copy. */
  sinceLabel: string;
  locationLabel: string;
}
const { locale, eyebrow, title, paragraphs, sinceLabel, locationLabel } = Astro.props;
const t = useTranslations(locale);
---

<section class="about">
  <div class="wrap grid">
    <div>
      <SectionHeading eyebrow={eyebrow} title={title} />
      {paragraphs.map((p) => <p class="text" data-reveal>{p}</p>)}
      <p class="row">
        <Button href={path(locale, "contact")} variant="outline">{t("nav.contact")}</Button>
      </p>
    </div>

    <dl class="facts plaque" data-reveal>
      <div>
        <dt>{sinceLabel}</dt>
        <dd>{CONTACT.since}</dd>
      </div>
      <div>
        <dt>{locationLabel}</dt>
        <dd>{CONTACT.cityLine}</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  /* Graphite band of the home rhythm, between the brands row and the newsletter. */
  .about {
    background: var(--color-graphite);
    border-block: 1px solid var(--ligne-faint);
    padding-block: var(--section-y);
  }

  .grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  @media (width >= 62rem) {
    .grid {
      grid-template-columns: 1.35fr 0.65fr;
      gap: 4rem;
    }
  }

  .text {
    color: var(--color-gris);
    max-width: 40rem;
  }
  .text + .text {
    margin-top: 1rem;
  }
  .row {
    margin: 2rem 0 0;
  }

  .facts {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 1.75rem 1.625rem;
  }
  .facts dt {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gris);
  }
  .facts dd {
    margin: 0.375rem 0 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.2;
    color: var(--color-or-clair);
  }
</style>
