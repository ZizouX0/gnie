---
/**
 * One numbered block of a long-form document (legal notice, privacy policy).
 *
 * The legal pages are the only place on the site where reading, not scanning,
 * is the point: the measure is capped at ~38rem (≈ 68 characters at the body
 * size) so a paragraph never runs the full 75rem page width, and the numbering
 * echoes the "La technologie" blocks of a machine page so the documents stay
 * inside the same family.
 *
 * Slotted markup keeps the copy in the page files (one file per language), so
 * this component styles it globally under `.prose` — the same idiom the media
 * components use for the images Astro renders for them.
 */
interface Props {
  /** Anchor target — the table of contents links to it. */
  id: string;
  /** Position in the document, rendered as 01, 02, … */
  index: number;
  title: string;
}
const { id, index, title } = Astro.props;
---

<section class="sec" aria-labelledby={id}>
  <p class="num" aria-hidden="true">{String(index).padStart(2, "0")}</p>
  <h2 id={id}>{title}</h2>
  <div class="prose"><slot /></div>
</section>

<style>
  .sec {
    border-top: 1px solid var(--ligne-faint);
    padding-block: 2.25rem;
  }
  .sec:first-of-type {
    border-top: 0;
  }
  .num {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1;
    color: var(--color-or);
    margin-bottom: 0.5rem;
  }
  h2 {
    font-size: var(--text-h3);
    margin-bottom: 1.125rem;
  }

  /* Reading measure. `anywhere` is what keeps a long e-mail address or URL
     from pushing the page sideways at 360px. */
  .prose {
    max-width: 38rem;
    overflow-wrap: anywhere;
  }
  .prose :global(p) {
    margin-bottom: 1rem;
  }
  .prose :global(p:last-child) {
    margin-bottom: 0;
  }
  .prose :global(h3) {
    font-size: 1.0625rem;
    margin: 1.75rem 0 0.625rem;
  }
  .prose :global(a) {
    color: var(--color-or);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .prose :global(a:hover) {
    color: var(--color-or-clair);
  }
  .prose :global(strong) {
    font-weight: 700;
  }

  /* Lists carry a gold dash rather than a bullet — the same restraint as the
     hairlines. */
  .prose :global(ul) {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
  }
  .prose :global(li) {
    position: relative;
    padding-left: 1.25rem;
    margin-bottom: 0.5rem;
  }
  .prose :global(li)::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--color-or);
  }

  /* Identity blocks (publisher, controller): micro-label above the value,
     the same dt/dd treatment as the facts line of a machine hero. */
  .prose :global(dl) {
    margin: 0 0 1rem;
  }
  .prose :global(dt) {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gris);
  }
  .prose :global(dd) {
    margin: 0.25rem 0 1rem;
  }
  .prose :global(dd span) {
    display: block;
  }

  /* A fact the client still has to supply. Deliberately unmistakable: dashed
     frame, grey text, machine-readable token — it can never be misread as a
     real registration number. */
  .prose :global(.todo) {
    display: inline-block;
    border: 1px dashed var(--ligne);
    border-radius: var(--radius-plaque);
    background: rgb(201 162 75 / 0.05);
    padding: 0.1875rem 0.625rem;
    color: var(--color-gris);
    font-size: var(--text-small);
    font-weight: 700;
  }
</style>
