---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { useTranslations, categoryLabel, type Locale, type Category } from "@/i18n/ui";
import { path } from "@/i18n/routes";

interface Props {
  locale: Locale;
  slug: string;
  name: string;
  category: Category;
  excerpt: string;
  image: ImageMetadata;
  /** One key figure, the plaque aesthetic at card scale. */
  miniLabel?: string;
  miniValue?: string;
  large?: boolean;
  eager?: boolean;
}
const {
  locale,
  slug,
  name,
  category,
  excerpt,
  image,
  miniLabel,
  miniValue,
  large = false,
  eager = false,
} = Astro.props;
const t = useTranslations(locale);
const href = path(locale, "machines", slug);
---

<article class:list={["card plaque", { large }]} data-category={category} data-reveal>
  <a href={href} class="hit" aria-label={name}>
    <div class="ph">
      <Image
        src={image}
        alt={`${name} — ${categoryLabel(locale, category)}`}
        widths={[320, 480, 720]}
        sizes="(width >= 62rem) 22rem, (width >= 48rem) 45vw, 92vw"
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : "auto"}
      />
    </div>
    <div class="body">
      <p class="eyebrow">{categoryLabel(locale, category)}</p>
      <h3>{name}</h3>
      <p class="ex">{excerpt}</p>
      <div class="mini">
        {
          miniLabel && miniValue ? (
            <span class="spec">
              {miniLabel} <b>{miniValue}</b>
            </span>
          ) : (
            <span />
          )
        }
        <span class="more">{t("cta.more")} →</span>
      </div>
    </div>
  </a>
</article>

<style>
  .card {
    overflow: hidden;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .card:hover {
    transform: translateY(-3px) scale(1.005);
    border-color: var(--color-or);
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.45);
  }
  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: border-color 0.2s ease;
    }
    .card:hover {
      transform: none;
      box-shadow: none;
    }
  }
  .card[hidden] {
    display: none;
  }

  .hit {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }
  .ph {
    background: var(--color-noir);
    border-bottom: 1px solid var(--ligne-faint);
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .large .ph {
    aspect-ratio: 3 / 2;
  }
  .ph :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.88) brightness(0.97);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.6875rem;
    padding: 1.375rem 1.375rem 1.5rem;
    flex: 1;
  }
  h3 {
    font-size: 1.5rem;
    line-height: 1.15;
  }
  .large h3 {
    font-size: 1.75rem;
  }
  .ex {
    font-size: var(--text-small);
    color: var(--color-gris);
    margin: 0;
  }
  .mini {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 0.875rem;
    border-top: 1px solid var(--ligne-faint);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gris);
  }
  /* A long spec value must never be able to stretch the card. */
  .spec {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-width: 0;
  }
  .spec b {
    color: var(--color-or-clair);
    font-weight: 700;
  }
  .more {
    color: var(--color-or);
    font-weight: 700;
    white-space: nowrap;
  }
</style>
