---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import WhatsAppFloat from "@/components/WhatsAppFloat.astro";
import { type Locale } from "@/i18n/ui";
import { alternatePath, hreflangPairs, path, type PageKey } from "@/i18n/routes";
import { CONTACT } from "@/config/site";
import logo from "@/assets/brand/gnie-logo-gold.png";

interface Props {
  locale: Locale;
  page: PageKey;
  slug?: string;
  title: string;
  description: string;
  /** Absolute or site-relative image for social sharing. */
  ogImage?: string;
  /** Machine name, so the floating WhatsApp button names it. */
  machine?: string;
  noindex?: boolean;
}
const {
  locale,
  page,
  slug,
  title,
  description,
  ogImage,
  machine,
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL("https://gnie-aesthetics.com");
const canonical = new URL(path(locale, page, slug), site).href;
const alternates = hreflangPairs(page, slug);
const alternate = alternatePath(locale, page, slug);
const fullTitle = `${title} | GNIE`;
/* Per-page sharing card, generated by scripts/og/generate.mjs and committed
   under public/og/. The path is the page's own identity — locale, page key,
   slug — so no page has to pass anything in. `ogImage` remains an escape
   hatch. The 404 and the styleguide declare page="home" and so inherit the
   French home card, which is right for pages nobody shares deliberately. */
const ogPath = `/og/${locale}/${page}${slug ? `/${slug}` : ""}.png`;
const ogUrl = new URL(ogImage ?? ogPath, site).href;

/**
 * GNIE is both a legal entity and a place of business with an address, a
 * phone and a map on the contact page, so it is typed as both. `@id` gives
 * the entity one stable identity for the rest of the graph to point at.
 *
 * No `priceRange`: LocalBusiness recommends it, but this catalogue is sold by
 * quotation and inventing a price band to satisfy a validator would be a lie.
 * `sameAs` is absent until the client supplies social profiles (`SOCIAL` is
 * still empty), and opening hours and coordinates are likewise unknown —
 * omitted rather than guessed.
 */
const organization = {
  "@context": "https://schema.org",
  "@type": ["Organization", "LocalBusiness"],
  "@id": new URL("#organization", site).href,
  name: "GNIE",
  legalName: "Global Nouvelle Innovation Esthétique",
  url: site.href,
  logo: new URL(logo.src, site).href,
  image: new URL(logo.src, site).href,
  foundingDate: String(CONTACT.since),
  address: {
    "@type": "PostalAddress",
    // All three lines: the third carries the Montplaisir district.
    streetAddress: CONTACT.addressLines.join(", "),
    addressLocality: CONTACT.locality,
    addressRegion: CONTACT.region,
    postalCode: CONTACT.postalCode,
    addressCountry: CONTACT.country,
  },
  // E.164, so the number resolves and dials outside Tunisia.
  telephone: CONTACT.phonePrimaryE164,
  ...(CONTACT.email ? { email: CONTACT.email } : {}),
  areaServed: "TN",
};

/**
 * The entity belongs where it is about the company, not on all 36 pages —
 * Google is explicit that it need not repeat site-wide, and emitting it on a
 * 404 or the dev styleguide is noise.
 */
const showOrganization = !noindex && (page === "home" || page === "contact");
---

<!doctype html>
<html lang={locale} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {/* A noindex page has no public URL to point at: the canonical is derived
        from `page`, so a dev page that borrows page="home" would otherwise
        claim to BE the home page. Emit none rather than a wrong one. */}
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {
      alternates.map((a) => (
        <link rel="alternate" hreflang={a.hreflang} href={new URL(a.href, site).href} />
      ))
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GNIE" />
    <meta property="og:locale" content={locale === "fr" ? "fr_TN" : "en_US"} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {/* Same reasoning as the canonical: a noindex page borrowing page="home"
        would otherwise advertise itself as the home page when its URL is
        pasted into a chat. */}
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogUrl} />
    {/* Dimensions let Facebook and LinkedIn lay the card out on first scrape
        instead of showing a blank while they fetch it. */}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={fullTitle} />

    <meta name="theme-color" content="#0B0B0D" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {
      showOrganization && (
        <script type="application/ld+json" set:html={JSON.stringify(organization)} is:inline />
      )
    }
    <script is:inline>
      document.documentElement.classList.remove("no-js");
      // Removing `no-js` disarms the CSS net that keeps [data-reveal] content
      // visible, and the script that re-arms it lives at the end of <body>.
      // If that script never runs — no module support, a blocked inline
      // module, an error before it — every section below the hero would stay
      // at opacity 0 for good. This failsafe costs nothing and makes that
      // impossible: if the reveal script has not announced itself shortly
      // after load, show everything.
      addEventListener("load", function () {
        setTimeout(function () {
          if (document.documentElement.hasAttribute("data-reveal-ready")) return;
          var els = document.querySelectorAll("[data-reveal]");
          for (var i = 0; i < els.length; i++) els[i].classList.add("is-in");
        }, 1000);
      });
    </script>
    <slot name="head" />
  </head>

  <body>
    <Header locale={locale} current={page} alternate={alternate} />
    {/* tabindex="-1" so the skip link actually moves focus here,
        rather than relying on the browser's sequential-focus guess. */}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <WhatsAppFloat locale={locale} machine={machine} />

    <script>
      // The single orchestrated gesture: fade-up on section entry.
      // Announce that this ran, so the failsafe in <head> stands down.
      document.documentElement.setAttribute("data-reveal-ready", "");
      const items = document.querySelectorAll("[data-reveal]");
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduce || !("IntersectionObserver" in window)) {
        items.forEach((el) => el.classList.add("is-in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-in");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.05 },
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style>
  /* The skip link focuses <main> so assistive tech lands inside it. It is a
     landing point, not a control, so it must not draw a focus ring around
     the whole page — the jump itself is the feedback. */
  main:focus-visible {
    outline: none;
  }
</style>
