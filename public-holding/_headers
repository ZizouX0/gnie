# Cloudflare Pages reads this file from the build output and applies the rules
# at the edge. Kept in step with public/_headers — the two builds use different
# public directories, so a header added to one does not reach the other.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Astro fingerprints these filenames, so a changed file is a new URL and the
# old one can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
