# Copy to `.env` to run the real site locally with everything switched on.
#
#   cp .env.example .env && npm run dev
#
# Every value here is optional. Missing ones degrade to a safe state rather
# than a broken one: no WhatsApp button instead of a dead button, a disabled
# form instead of one that posts nowhere. That is why a local run without this
# file looks slightly emptier than production.

# The client's WhatsApp Business line, digits only, country code included.
PUBLIC_WHATSAPP_NUMBER=21690157560

# Formspree form id — the quote form needs it. Not yet created; the form
# renders in a disabled state without it.
# PUBLIC_FORMSPREE_ID=

# Brevo newsletter form URL. Not yet created.
# PUBLIC_BREVO_FORM_URL=

# Only needed if you want canonical URLs to point somewhere other than
# https://gnie-laser.com
# PUBLIC_SITE_URL=http://localhost:4321
