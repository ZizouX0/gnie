---
/**
 * The holding page shell — one layout, two languages.
 *
 * Deliberately standalone. It imports the same two typefaces as the site but
 * declares its own handful of tokens instead of pulling in global.css and
 * Tailwind, because this page has a lifecycle of weeks and then gets deleted:
 * carrying the whole design system for one screen would mean maintaining two
 * consumers of it for no benefit. The five values below are copied from
 * `src/styles/global.css`, which remains the source of truth.
 *
 * No JavaScript and no cookie. Still no form, deliberately: a form collects
 * personal data and triggers the very privacy-policy obligation this page
 * exists to wait for. A `mailto:` link does not — it hands the visitor to
 * their own mail client and stores nothing — so an address is safe here where
 * a form is not.
 *
 * WhatsApp and e-mail follow the same rule as the rest of the site: when the
 * value is missing they render nothing at all, rather than a button that
 * fails or an empty row. The phone numbers are always present and carry the
 * page on their own until the other two are configured.
 */
import "@fontsource/cormorant-garamond/latin-400.css";
import "@fontsource/cormorant-garamond/latin-600.css";
import "@fontsource/manrope/latin-400.css";
import "@fontsource/manrope/latin-500.css";
import logo from "@/assets/brand/gnie-logo-gold.png";
import { Image } from "astro:assets";
import { CONTACT, ENV } from "@/config/site";

interface Props {
  locale: "fr" | "en";
  title: string;
  description: string;
  eyebrow: string;
  headline: string;
  accent: string;
  intro: string;
  bodyTitle: string;
  body: string[];
  catalogueTitle: string;
  catalogue: { n: string; label: string }[];
  contactTitle: string;
  contactNote: string;
  addressLabel: string;
  /** Label on the WhatsApp button. Rendered only when a number is configured. */
  whatsappLabel: string;
  /** Prefilled first message, so the visitor does not start from a blank chat. */
  whatsappMessage: string;
  emailLabel: string;
  switchLabel: string;
  switchHref: string;
}
const {
  locale,
  title,
  description,
  eyebrow,
  headline,
  accent,
  intro,
  bodyTitle,
  body,
  catalogueTitle,
  catalogue,
  contactTitle,
  contactNote,
  addressLabel,
  whatsappLabel,
  whatsappMessage,
  emailLabel,
  switchLabel,
  switchHref,
} = Astro.props;

/* wa.me wants digits only — no +, no spaces. Empty number, no button. */
const waNumber = ENV.whatsapp.replace(/[^\d]/g, "");
const waHref = waNumber
  ? `https://wa.me/${waNumber}?text=${encodeURIComponent(whatsappMessage)}`
  : null;

const site = Astro.site ?? new URL("https://gnie-laser.com");
const canonical = new URL(locale === "fr" ? "/" : "/en/", site).href;

/**
 * The company entity, exactly as the real site emits it, minus what is still
 * unknown. It is worth carrying on a holding page: it is what lets a search
 * for "GNIE Tunis" resolve to this address and these numbers while the
 * catalogue is still off the air.
 */
const organization = {
  "@context": "https://schema.org",
  "@type": ["Organization", "LocalBusiness"],
  "@id": new URL("#organization", site).href,
  name: "GNIE",
  legalName: "Global Nouvelle Innovation Esthétique",
  url: site.href,
  logo: new URL(logo.src, site).href,
  foundingDate: String(CONTACT.since),
  address: {
    "@type": "PostalAddress",
    streetAddress: CONTACT.addressLines.join(", "),
    addressLocality: CONTACT.locality,
    addressRegion: CONTACT.region,
    postalCode: CONTACT.postalCode,
    addressCountry: CONTACT.country,
  },
  telephone: CONTACT.phonePrimaryE164,
  areaServed: "TN",
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={new URL("/", site).href} />
    <link rel="alternate" hreflang="en" href={new URL("/en/", site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL("/", site).href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GNIE" />
    <meta property="og:locale" content={locale === "fr" ? "fr_TN" : "en_US"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <meta name="theme-color" content="#0b0b0d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} is:inline />
  </head>

  <body>
    <main>
      <div class="wrap">
        <header class="head">
          <Image src={logo} alt="GNIE" widths={[120, 240]} sizes="120px" loading="eager" />
          <a class="lang" href={switchHref} hreflang={locale === "fr" ? "en" : "fr"}>
            {switchLabel}
          </a>
        </header>

        <section class="hero">
          <p class="eyebrow">{eyebrow}</p>
          <h1>{headline} <em>{accent}</em></h1>
          <p class="intro">{intro}</p>
        </section>

        <div class="rule"></div>

        <section class="cols">
          <div>
            <h2>{bodyTitle}</h2>
            {body.map((p) => <p>{p}</p>)}
          </div>

          <div>
            <h2>{catalogueTitle}</h2>
            <dl class="figs">
              {
                catalogue.map((c) => (
                  <div>
                    <dt>{c.n}</dt>
                    <dd>{c.label}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </section>

        <div class="rule"></div>

        <section class="cols contact">
          <div>
            <h2>{contactTitle}</h2>
            <p class="note">{contactNote}</p>
          </div>
          <div>
            <p class="tels">
              <a href={`tel:${CONTACT.phonePrimaryE164}`}>{CONTACT.phonePrimary}</a>
              <span aria-hidden="true">·</span>
              <a href={`tel:${CONTACT.phoneSecondaryE164}`}>{CONTACT.phoneSecondary}</a>
            </p>

            {
              waHref && (
                <a class="wa" href={waHref} target="_blank" rel="noopener noreferrer">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm5.8 14.03c-.24.68-1.4 1.3-1.93 1.35-.53.05-1.03.24-3.47-.72-2.94-1.16-4.8-4.2-4.95-4.4-.14-.19-1.17-1.56-1.17-2.98 0-1.42.75-2.12 1.01-2.41.26-.29.57-.36.76-.36l.55.01c.17.01.41-.07.64.48.24.55.79 1.93.86 2.07.07.14.12.31.02.5-.1.19-.15.31-.29.48-.14.17-.3.38-.43.5-.14.15-.29.31-.12.58.17.29.75 1.24 1.62 2.01 1.11.99 2.05 1.3 2.34 1.45.29.14.46.12.63-.07.17-.19.72-.84.91-1.13.19-.29.38-.24.65-.14.26.1 1.65.78 1.93.92.29.14.48.22.55.34.07.12.07.7-.17 1.38z" />
                  </svg>
                  {whatsappLabel}
                </a>
              )
            }

            {
              CONTACT.email && (
                <p class="mail">
                  <span class="lbl">{emailLabel}</span>
                  <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
                </p>
              )
            }

            <address>
              <span class="lbl">{addressLabel}</span>
              {CONTACT.addressLines.join(", ")}
            </address>
          </div>
        </section>

        <footer>
          <span>Global Nouvelle Innovation Esthétique</span>
          <span>© {new Date().getFullYear()} GNIE</span>
        </footer>
      </div>
    </main>
  </body>
</html>

<style>
  /* Copied from src/styles/global.css — see the note at the top of this file. */
  :root {
    --noir: #0b0b0d;
    --carbone: #1c1c21;
    --or: #c9a24b;
    --ivoire: #f3eee4;
    --gris: #98938a;
    --hairline: color-mix(in srgb, var(--or) 22%, transparent);
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  :global(html),
  :global(body) {
    margin: 0;
    padding: 0;
  }

  :global(body) {
    background: var(--noir);
    color: var(--ivoire);
    font-family: "Manrope", system-ui, sans-serif;
    font-size: 1rem;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }

  main {
    min-height: 100svh;
    display: grid;
    place-items: center;
    /* A single warm bloom behind the mark, the site's one lighting gesture. */
    background:
      radial-gradient(60rem 40rem at 78% -10%, color-mix(in srgb, var(--or) 9%, transparent), transparent 65%),
      var(--noir);
    padding: 2rem 1.25rem 3rem;
  }

  .wrap {
    width: 100%;
    max-width: 58rem;
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .head :global(img) {
    width: 60px;
    height: auto;
  }

  .lang {
    color: var(--gris);
    font-size: 0.78rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
  }

  .lang:hover,
  .lang:focus-visible {
    color: var(--or);
    border-bottom-color: var(--hairline);
  }

  .hero {
    margin-top: clamp(2.5rem, 8vw, 5rem);
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--or);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 400;
    font-size: clamp(2.4rem, 7.5vw, 4.25rem);
    line-height: 1.06;
    letter-spacing: -0.01em;
  }

  h1 em {
    display: block;
    font-style: normal;
    color: var(--or);
  }

  .intro {
    margin: 1.5rem 0 0;
    max-width: 42ch;
    color: color-mix(in srgb, var(--ivoire) 82%, transparent);
    font-size: 1.05rem;
  }

  .rule {
    height: 1px;
    background: var(--hairline);
    margin: clamp(2.5rem, 7vw, 4rem) 0;
  }

  .cols {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  @media (width >= 46rem) {
    .cols {
      grid-template-columns: 1.35fr 1fr;
    }
  }

  h2 {
    margin: 0 0 1rem;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 400;
    font-size: 1.6rem;
    line-height: 1.2;
  }

  .cols p {
    margin: 0 0 0.9rem;
    color: color-mix(in srgb, var(--ivoire) 76%, transparent);
    font-size: 0.95rem;
  }

  .cols p:last-child {
    margin-bottom: 0;
  }

  .figs {
    margin: 0;
    display: grid;
    gap: 0.9rem;
  }

  .figs > div {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    border-top: 1px solid color-mix(in srgb, var(--or) 12%, transparent);
    padding-top: 0.9rem;
  }

  .figs > div:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .figs dt {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 1.7rem;
    line-height: 1;
    color: var(--or);
    min-width: 2.2ch;
  }

  .figs dd {
    margin: 0;
    color: var(--gris);
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .contact .note {
    margin: 0;
    color: color-mix(in srgb, var(--ivoire) 76%, transparent);
    font-size: 0.95rem;
  }

  /* Scoped through .cols: the contact block now sits inside that grid, whose
     `.cols p` rule is more specific than a bare `.tels` and was silently
     shrinking the phone numbers to body size. They are the one thing on this
     page a visitor has to be able to act on. */
  .cols .tels {
    margin: 0 0 1.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(1.6rem, 3.4vw, 2.1rem);
    line-height: 1.15;
  }

  .tels a {
    color: var(--ivoire);
    text-decoration: none;
    border-bottom: 1px solid var(--hairline);
    padding-bottom: 3px;
  }

  .tels a:hover,
  .tels a:focus-visible {
    color: var(--or);
    border-bottom-color: var(--or);
  }

  .tels span {
    color: var(--or);
  }

  /* The one filled control on the page. WhatsApp is how buyers in Tunisia
     actually open a conversation, so it gets weight the tel: links do not. */
  .wa {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 1.25rem;
    padding: 0.7rem 1.15rem;
    background: var(--or);
    color: var(--noir);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid var(--or);
    transition: background 0.15s ease;
  }

  .wa:hover,
  .wa:focus-visible {
    background: transparent;
    color: var(--or);
  }

  .wa svg {
    width: 1.05rem;
    height: 1.05rem;
    fill: currentColor;
    flex: none;
  }

  .cols .mail {
    margin: 0 0 1.25rem;
    font-size: 0.88rem;
  }

  .mail a {
    color: var(--ivoire);
    text-decoration: none;
    border-bottom: 1px solid var(--hairline);
    padding-bottom: 2px;
  }

  .mail a:hover,
  .mail a:focus-visible {
    color: var(--or);
    border-bottom-color: var(--or);
  }

  address {
    font-style: normal;
    color: var(--gris);
    font-size: 0.88rem;
  }

  .lbl {
    display: block;
    color: var(--or);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 0.3rem;
  }

  footer {
    margin-top: clamp(2.5rem, 7vw, 4rem);
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--or) 12%, transparent);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    color: color-mix(in srgb, var(--gris) 80%, transparent);
    font-size: 0.76rem;
  }

  :global(a:focus-visible) {
    outline: 2px solid var(--or);
    outline-offset: 3px;
  }
</style>
