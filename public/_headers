# Edge headers for the real site. Cloudflare Pages reads this from the build
# output and applies the rules per path.
#
# Kept in step with public-holding/_headers by hand: the holding build uses a
# different public directory, so a rule added here does not reach it.
#
# No Content-Security-Policy on purpose. The site carries several inline
# scripts by design — the reveal observer, the no-JS failsafe in <head>, the
# JSON-LD blocks — and embeds YouTube on the machine pages that have footage.
# A policy loose enough to allow all of that (`unsafe-inline` plus the YouTube
# origins) would buy close to nothing while risking a silently broken page.
# Worth revisiting with hashed script sources, not before.

/*
  # Stop browsers second-guessing a declared Content-Type.
  X-Content-Type-Options: nosniff
  # Send the full referrer to ourselves, only the origin off-site.
  Referrer-Policy: strict-origin-when-cross-origin
  # Refuses to be framed by anyone. Does not affect the YouTube iframe this
  # site embeds — that direction is not governed by this header.
  X-Frame-Options: DENY
  # The site asks for none of these; say so rather than leave it implicit.
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Astro fingerprints these filenames, so any change produces a new URL and the
# old one is safe to cache indefinitely.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Sharing cards change only when a page's title or hero does, and they are
# fetched by crawlers rather than visitors. A day is plenty.
/og/*
  Cache-Control: public, max-age=86400
